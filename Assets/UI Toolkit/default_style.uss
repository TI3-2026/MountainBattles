:root {
}

.text_title {
    -unity-text-align: middle-center;
    color: rgb(228, 169, 99);
    font-size: 150px;
    -unity-font-definition: url("project://database/Assets/Fonts/Square-Black.ttf?fileID=12800000&guid=d7cffddcbc0cc8f4ebe6e28eb9804082&type=3#Square-Black");
    -unity-font-style: normal;
    height: 50%;
    margin-top: 0;
    padding-top: 5%;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
    letter-spacing: 5px;
}

.button_normal {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 72px;
    padding-top: 40px;
    padding-right: 40px;
    padding-bottom: 40px;
    padding-left: 40px;
    background-color: rgba(69, 80, 88, 0.25);
    margin-top: 40px;
    margin-right: 40px;
    margin-bottom: 40px;
    margin-left: 40px;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
    -unity-font-definition: url("project://database/Assets/Fonts/Square-Black.ttf?fileID=12800000&guid=d7cffddcbc0cc8f4ebe6e28eb9804082&type=3#Square-Black");
    letter-spacing: 5px;
}

.button_normal:hover {
    scale: 1.25 1.25 1.25;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    font-size: 80px;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    letter-spacing: 0;
}
